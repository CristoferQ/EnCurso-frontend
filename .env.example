# URL Base de la API Backend
VITE_API_BASE_URL=http://tu-servidor-o-localhost:8080/api/v1

# Simulación de latencia en milisegundos (0 para desarrollo normal / producción)
VITE_SIMULATED_NETWORK_DELAY_MS=0